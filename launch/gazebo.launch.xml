<launch>
	<set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share pool_simulator)/models" />

	<include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
		<arg name="gz_args" value="-v 3 $(find-pkg-share pool_simulator)/world/pool.world"/>
	</include>
	
	<node pkg="ros_gz_bridge" exec="parameter_bridge"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"/>

</launch>
